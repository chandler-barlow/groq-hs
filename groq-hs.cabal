cabal-version:      3.0
name:               groq-hs
version:            0.1.0.0
synopsis:           Haskell library for interacting with groq cloud
license:            MIT
license-file:       LICENSE
author:             chandler-barlow
maintainer:         chandlerbrlw@gmail.com
build-type:         Simple
extra-doc-files:    CHANGELOG.md


common warnings
    ghc-options: -Wall

common opts

library
    import: warnings
    default-language: GHC2024
    default-extensions:
        AllowAmbiguousTypes,
        DataKinds,
        DeriveGeneric,
        DuplicateRecordFields,
        FlexibleContexts,
        NoMonomorphismRestriction,
        TypeApplications,
        OverloadedRecordDot,
        OverloadedStrings,
        OverloadedLabels
    hs-source-dirs:   lib
    exposed-modules:  
        Utils,
        Groq,
        Groq.Types.Models,
        Groq.Types.ChatCompletion
    build-depends:    
        base,
        aeson,
        mtl,
        data-default,
        req,
        text,
        microlens,
        generic-lens

test-suite groq-hs-test
    import: warnings
    type:             exitcode-stdio-1.0
    default-language: GHC2024
    default-extensions:
        AllowAmbiguousTypes,
        DataKinds,
        DeriveGeneric,
        DuplicateRecordFields,
        FlexibleContexts,
        NoMonomorphismRestriction,
        TypeApplications,
        OverloadedRecordDot,
        OverloadedStrings,
        OverloadedLabels
    hs-source-dirs:   test
    main-is:          Main.hs
    -- other-modules:
    build-depends:
        base ^>=4.20.2.0,
        groq-hs
